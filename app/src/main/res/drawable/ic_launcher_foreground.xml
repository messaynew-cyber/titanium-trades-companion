<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- ✦ GLASS COCKPIT monogram: a nav "T" on an obsidian HUD.
         Gold mast = the pilot's attitude spine; green chevron = runway / take signal. -->

    <!-- gold vertical mast (centered on safe zone axis x=54; from above y=36 to chevron) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F2C14E"
        android:strokeWidth="6.4"
        android:strokeLineCap="round"
        android:pathData="M54,36 L54,66" />

    <!-- gold horizontal bar of the T (the crossbar = synthetic horizon) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F2C14E"
        android:strokeWidth="6.4"
        android:strokeLineCap="round"
        android:pathData="M35,49 L73,49" />

    <!-- green take-off chevron under the mast (a subtle aircraft/rwy cue) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#44D68B"
        android:strokeWidth="5.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M44,71 L54,62 L64,71" />

    <!-- fine gold altitude tick right of mast -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F2C14E"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M70,57 L74,57 M70,61 L74,61" />
</vector>
